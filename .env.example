# API keys requeridas para el TFM Inga
# Copiar a `.env` (sin commit) y rellenar los valores reales

# Para embeddings RAG: aistudio.google.com -> API keys
GOOGLE_API_KEY=your-gemini-api-key-here

# Para pipeline LLM+RAG (Claude): console.anthropic.com -> API keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Para OCR de PDFs nuevos (Torres Amat): console.mistral.ai -> API keys
MISTRAL_API_KEY=your-mistral-api-key-here
