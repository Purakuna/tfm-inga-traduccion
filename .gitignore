# macOS
.DS_Store

# Documentos personales con firmas (no publicar)
Compromiso*.pdf
Compromisos*.pdf

# Memoria/configuracion local de herramientas asistenciales
.claude/

# LaTeX artefactos
latex/*.aux
latex/*.bcf
latex/*.log
latex/*.out
latex/*.run.xml
latex/*.toc
latex/*.bbl
latex/*.blg

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.ipynb_checkpoints/

# Modelos descargados (se cachean en ~/.cache/huggingface)
# Anclado al root para no afectar src/models/
/models/
*.safetensors
*.bin

# Datos temporales
*.tmp
*.swp

# Secrets (Entrega 2)
.env

# uv lockfile artifacts
uv.toml.bak

# Entrega 2: artefactos pesados que se regeneran
lance_indexes/*.lance/
datos/cache/
entrega2/TFM_Entrega2_EslavaSantos.docx
entrega2/TFM_Entrega2_EslavaSantos.pdf

# Word: archivos de bloqueo y backups automaticos del script build_docx_e2.py
~$*
*.backup_*.docx

# Web app
webapp/frontend/node_modules/
webapp/frontend/dist/
.playwright-mcp/
# Wiki: base y arbol markdown se reconstruyen desde datos/wiki/seed + feedback
datos/wiki/wiki.db*
datos/wiki/seed/.cache/
# Arbol markdown de la wiki: se reconstruye con python -m src.wiki.bootstrap
datos/wiki/pages/
